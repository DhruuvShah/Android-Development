        <activity
            android:name=".ViewDataActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".UpdateDeleteActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".DataBaseActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
