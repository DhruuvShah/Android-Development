<?xml version="1.0" encoding="utf-8"?>
<!-- Reusable top bar snippet pattern (included manually in each screen for simplicity) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
    android:gravity="center_vertical" android:paddingHorizontal="16dp" android:paddingVertical="14dp">
    <ImageButton android:id="@+id/backButton" android:layout_width="36dp" android:layout_height="36dp"
        android:background="@android:color/transparent" android:src="@drawable/ic_back"
        app:tint="@color/ink" android:contentDescription="Back" />
    <TextView android:id="@+id/screenTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="@color/ink" android:textSize="18sp" android:textStyle="bold" android:layout_marginStart="8dp" />
</LinearLayout>
