<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
    android:background="@drawable/bg_card" android:padding="24dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="New Expense"
        android:textColor="@color/ink" android:textSize="18sp" android:textStyle="bold" android:layout_marginBottom="16dp"/>
    <EditText android:id="@+id/expenseTitleInput" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/bg_input" android:hint="Title (e.g. Groceries)" android:layout_marginBottom="10dp"/>
    <EditText android:id="@+id/expenseCategoryInput" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/bg_input" android:hint="Category (e.g. Food)" android:layout_marginBottom="10dp"/>
    <EditText android:id="@+id/expenseAmountInput" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/bg_input" android:hint="Amount" android:inputType="numberDecimal"/>
</LinearLayout>
