<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:ns1="http://schemas.android.com/tools">
    <color name="accent">@color/manifold_primary</color>
    <color name="accent_dark">#283161</color>
    <color name="bg">@color/manifold_canvas</color>
    <color name="danger">@color/manifold_error</color>
    <color name="divider">@color/manifold_divider</color>
    <color name="ink">@color/manifold_ink_900</color>
    <color name="ink_secondary">@color/manifold_ink_600</color>
    <color name="manifold_canvas">#F5F5F1</color>
    <color name="manifold_divider">#E4E3DE</color>
    <color name="manifold_error">#A73E3E</color>
    <color name="manifold_ink_300">#A6A8B0</color>
    <color name="manifold_ink_600">#5B5D66</color>
    <color name="manifold_ink_900">#1B1C20</color>
    <color name="manifold_primary">#34407C</color>
    <color name="manifold_primary_container">#DEE1F0</color>
    <color name="manifold_success">#3C7A5C</color>
    <color name="manifold_surface">#FFFFFF</color>
    <color name="manifold_warning">#B07A2E</color>
    <color name="success">@color/manifold_success</color>
    <color name="surface">@color/manifold_surface</color>
    <color name="white">#FFFFFF</color>
    <string name="app_name">Learning Hub</string>
    <style name="Manifold"/>
    <style name="Manifold.CalcButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_columnWeight">1</item>
        <item name="android:layout_rowWeight">1</item>
        <item name="android:layout_gravity">fill</item>
        <item name="android:layout_margin">6dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">22sp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@null</item>
        <item name="android:elevation">0dp</item>
    </style>
    <style name="Manifold.CalcButton.Digit">
        <item name="android:background">@drawable/bg_calc_digit</item>
        <item name="android:textColor">@color/manifold_ink_900</item>
    </style>
    <style name="Manifold.CalcButton.Equals">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Manifold.Large</item>
    </style>
    <style name="Manifold.CalcButton.Operator">
        <item name="android:background">@drawable/bg_calc_operator</item>
        <item name="android:textColor">@color/manifold_primary</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Manifold.CalcButton.Operator.Accent">
        <item name="android:background">@drawable/bg_calc_operator</item>
        <item name="android:textColor">@color/manifold_primary</item>
    </style>
    <style name="Manifold.Chip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:textColor">@color/manifold_ink_900</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="Manifold.Chip.Selected">
        <item name="android:background">@drawable/bg_chip_selected</item>
        <item name="android:textColor">@color/white</item>
    </style>
    <style name="ShapeAppearance.Manifold.Large" parent="ShapeAppearance.MaterialComponents.LargeComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">28dp</item>
    </style>
    <style name="ShapeAppearance.Manifold.Medium" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>
    <style name="ShapeAppearance.Manifold.Small" parent="ShapeAppearance.MaterialComponents.SmallComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">8dp</item>
    </style>
    <style name="Theme.LearningHub" parent="Theme.Manifold"/>
    <style name="Theme.Manifold" parent="Theme.MaterialComponents.Light.NoActionBar">
        
        <item name="colorPrimary">@color/manifold_primary</item>
        <item name="colorPrimaryDark">@color/accent_dark</item>
        <item name="colorAccent">@color/manifold_primary</item>

        <item name="android:windowBackground">@color/manifold_canvas</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" ns1:targetApi="o_mr1">true</item>

        
        <item name="android:windowAnimationStyle">@style/WindowAnimations</item>

        
        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.Manifold.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.Manifold.Medium</item>
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.Manifold.Large</item>
    </style>
    <style name="WindowAnimations">
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_right</item>
        <item name="android:activityOpenExitAnimation">@anim/slide_out_left</item>
        <item name="android:activityCloseEnterAnimation">@anim/slide_in_left</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_right</item>
    </style>
</resources>