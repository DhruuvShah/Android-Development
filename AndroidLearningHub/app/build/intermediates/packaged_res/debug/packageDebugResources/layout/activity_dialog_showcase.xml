<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/manifold_canvas"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="Back"
            android:src="@drawable/ic_back"
            app:tint="@color/manifold_ink_900" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Dialog Showcase"
            android:textColor="@color/manifold_ink_900"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginBottom="48dp"
            app:cardBackgroundColor="@color/manifold_primary_container"
            app:cardCornerRadius="60dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="32dp"
                android:src="@drawable/ic_dialog"
                app:tint="@color/manifold_primary" />
        </com.google.android.material.card.MaterialCardView>

        <Button
            android:id="@+id/simpleDialogBtn"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_button_secondary"
            android:text="Simple AlertDialog"
            android:textAllCaps="false"
            android:textColor="@color/manifold_primary"
            app:backgroundTint="@null" />

        <Button
            android:id="@+id/listDialogBtn"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_button_secondary"
            android:text="List Choice Dialog"
            android:textAllCaps="false"
            android:textColor="@color/manifold_primary"
            app:backgroundTint="@null" />

        <Button
            android:id="@+id/customDialogBtn"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_button_secondary"
            android:text="Custom Layout Dialog"
            android:textAllCaps="false"
            android:textColor="@color/manifold_primary"
            app:backgroundTint="@null" />

        <Button
            android:id="@+id/destructiveDialogBtn"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/bg_button_primary"
            android:text="Destructive Confirm"
            android:textAllCaps="false"
            android:textColor="@color/white"
            app:backgroundTint="@null" />

    </LinearLayout>
</LinearLayout>
