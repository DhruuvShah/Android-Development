<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/manifold_canvas"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="Back"
            android:src="@drawable/ic_back"
            app:tint="@color/manifold_ink_900" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Calculator"
            android:textColor="@color/manifold_ink_900"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Display -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1.2"
        android:gravity="bottom|end"
        android:orientation="vertical"
        android:padding="32dp">

        <TextView
            android:id="@+id/calcExpression"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="125 + 24 × 114"
            android:textColor="@color/manifold_ink_600"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/calcDisplay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="3,456.78"
            android:textColor="@color/manifold_ink_900"
            android:textSize="48sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Keypad -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3"
        android:columnCount="4"
        android:padding="16dp"
        android:rowCount="5">

        <!-- Row 1 -->
        <Button
            android:id="@+id/btnClear"
            style="@style/Manifold.CalcButton.Operator"
            android:text="C" />

        <Button
            android:id="@+id/btnPlusMinus"
            style="@style/Manifold.CalcButton.Operator"
            android:text="+/−" />

        <Button
            android:id="@+id/btnPercent"
            style="@style/Manifold.CalcButton.Operator"
            android:text="%" />

        <ImageButton
            android:id="@+id/btnDel"
            style="@style/Manifold.CalcButton.Operator"
            android:padding="16dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_backspace"
            app:tint="@color/manifold_primary" />

        <!-- Row 2 -->
        <Button
            android:id="@+id/btn7"
            style="@style/Manifold.CalcButton.Digit"
            android:text="7" />

        <Button
            android:id="@+id/btn8"
            style="@style/Manifold.CalcButton.Digit"
            android:text="8" />

        <Button
            android:id="@+id/btn9"
            style="@style/Manifold.CalcButton.Digit"
            android:text="9" />

        <Button
            android:id="@+id/btnDivide"
            style="@style/Manifold.CalcButton.Operator.Accent"
            android:text="/" />

        <!-- Row 3 -->
        <Button
            android:id="@+id/btn4"
            style="@style/Manifold.CalcButton.Digit"
            android:text="4" />

        <Button
            android:id="@+id/btn5"
            style="@style/Manifold.CalcButton.Digit"
            android:text="5" />

        <Button
            android:id="@+id/btn6"
            style="@style/Manifold.CalcButton.Digit"
            android:text="6" />

        <Button
            android:id="@+id/btnMultiply"
            style="@style/Manifold.CalcButton.Operator.Accent"
            android:text="×" />

        <!-- Row 4 -->
        <Button
            android:id="@+id/btn1"
            style="@style/Manifold.CalcButton.Digit"
            android:text="1" />

        <Button
            android:id="@+id/btn2"
            style="@style/Manifold.CalcButton.Digit"
            android:text="2" />

        <Button
            android:id="@+id/btn3"
            style="@style/Manifold.CalcButton.Digit"
            android:text="3" />

        <Button
            android:id="@+id/btnMinus"
            style="@style/Manifold.CalcButton.Operator.Accent"
            android:text="−" />

        <!-- Row 5 -->
        <Button
            android:id="@+id/btn0"
            style="@style/Manifold.CalcButton.Digit"
            android:text="0" />

        <Button
            android:id="@+id/btnDot"
            style="@style/Manifold.CalcButton.Digit"
            android:text="." />

        <Button
            android:id="@+id/btnPlus"
            style="@style/Manifold.CalcButton.Operator.Accent"
            android:text="+" />

        <Button
            android:id="@+id/btnEquals"
            style="@style/Manifold.CalcButton.Equals"
            android:text="=" />
    </GridLayout>

</LinearLayout>
