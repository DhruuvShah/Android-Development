<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/manifold_canvas"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_marginBottom="48dp"
        app:cardBackgroundColor="@color/manifold_primary_container"
        app:cardCornerRadius="80dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <ImageView
            android:id="@+id/permissionIcon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="48dp"
            android:src="@drawable/ic_camera"
            app:tint="@color/manifold_primary" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/rationaleTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Why we need this"
        android:textColor="@color/manifold_ink_900"
        android:textSize="32sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/rationaleDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="48dp"
        android:gravity="center"
        android:lineSpacingExtra="4dp"
        android:text="Allows you to easily capture new photos or add images from your device to enrich your creations and personalize your experience."
        android:textColor="@color/manifold_ink_600"
        android:textSize="16sp" />

    <Button
        android:id="@+id/allowButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_button_primary"
        android:elevation="0dp"
        android:text="Allow"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="16sp"
        app:backgroundTint="@null" />

    <TextView
        android:id="@+id/notNowButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:text="Not now"
        android:textColor="@color/manifold_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>
