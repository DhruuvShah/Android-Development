<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/manifold_canvas"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@android:color/transparent"
            android:contentDescription="Back"
            android:src="@drawable/ic_back"
            app:tint="@color/manifold_ink_900" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Student Enrollment"
            android:textColor="@color/manifold_ink_900"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Academic Year 2024-2025"
            android:textColor="@color/manifold_ink_600"
            android:textSize="16sp" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            app:boxCornerRadiusBottomEnd="28dp"
            app:boxCornerRadiusBottomStart="28dp"
            app:boxCornerRadiusTopEnd="28dp"
            app:boxCornerRadiusTopStart="28dp"
            app:boxStrokeColor="@color/manifold_primary"
            app:hintEnabled="false"
            app:endIconDrawable="@drawable/ic_profile"
            app:endIconMode="custom"
            app:endIconTint="@color/manifold_ink_600">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/fullNameInput"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="@drawable/bg_input"
                android:hint="Full Name"
                android:paddingEnd="56dp"
                android:textColor="@color/manifold_ink_900" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:boxCornerRadiusBottomEnd="28dp"
            app:boxCornerRadiusBottomStart="28dp"
            app:boxCornerRadiusTopEnd="28dp"
            app:boxCornerRadiusTopStart="28dp"
            app:boxStrokeColor="@color/manifold_primary"
            app:hintEnabled="false">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/studentIdInput"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="@drawable/bg_input"
                android:hint="Student ID"
                android:textColor="@color/manifold_ink_900" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:boxCornerRadiusBottomEnd="28dp"
            app:boxCornerRadiusBottomStart="28dp"
            app:boxCornerRadiusTopEnd="28dp"
            app:boxCornerRadiusTopStart="28dp"
            app:boxStrokeColor="@color/manifold_primary"
            app:hintEnabled="false"
            app:endIconDrawable="@drawable/ic_email"
            app:endIconMode="custom"
            app:endIconTint="@color/manifold_ink_600">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/emailInput"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="@drawable/bg_input"
                android:hint="Email Address"
                android:paddingEnd="56dp"
                android:textColor="@color/manifold_ink_900" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Select a Dorm Room"
            android:textColor="@color/manifold_ink_900"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Room Selector Grid -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:columnCount="4">

            <TextView
                style="@style/Manifold.Chip"
                android:layout_margin="4dp"
                android:background="@drawable/bg_chip_selected"
                android:backgroundTint="@color/manifold_primary_container"
                android:text="A101"
                android:textColor="@color/manifold_primary" />

            <TextView
                style="@style/Manifold.Chip"
                android:layout_margin="4dp"
                android:text="B204" />

            <TextView
                style="@style/Manifold.Chip"
                android:layout_margin="4dp"
                android:text="C103" />

            <TextView
                style="@style/Manifold.Chip"
                android:layout_margin="4dp"
                android:text="D302" />
        </GridLayout>

        <Button
            android:id="@+id/submitEnrollment"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:layout_marginTop="48dp"
            android:background="@drawable/bg_button_primary"
            android:text="Submit Enrollment"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="18sp"
            app:backgroundTint="@null"
            app:icon="@android:drawable/ic_media_play"
            app:iconGravity="end"
            app:iconTint="@color/white" />

    </LinearLayout>
</ScrollView>
