<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="@dimen/spacing_s">

    <TextView
        android:id="@+id/tv_avatar_initial"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_avatar_circle"
        android:gravity="center"
        android:textColor="@color/background_primary"
        android:textStyle="bold"
        tools:text="A"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_name"
        style="@style/Text.Body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_s"
        tools:text="Alex"
        app:layout_constraintStart_toEndOf="@id/tv_avatar_initial"
        app:layout_constraintTop_toTopOf="@id/tv_avatar_initial"
        app:layout_constraintBottom_toTopOf="@id/progress_balance" />

    <TextView
        android:id="@+id/tv_up_next_tag"
        style="@style/Text.Muted"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/spacing_s"
        android:background="@drawable/bg_tag_pill"
        android:paddingHorizontal="@dimen/spacing_s"
        android:paddingVertical="2dp"
        android:text="@string/label_up_next"
        android:visibility="visible"
        tools:visibility="visible"
        app:layout_constraintStart_toEndOf="@id/tv_name"
        app:layout_constraintTop_toTopOf="@id/tv_name"
        app:layout_constraintBottom_toBottomOf="@id/tv_name" />

    <TextView
        android:id="@+id/tv_score"
        style="@style/Text.Score"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_avatar_initial"
        app:layout_constraintBottom_toTopOf="@id/progress_balance" />

    <ProgressBar
        android:id="@+id/progress_balance"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="6dp"
        android:layout_marginTop="@dimen/spacing_xs"
        android:max="100"
        android:progressDrawable="@drawable/progress_balance_bar"
        tools:progress="70"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_name" />

</androidx.constraintlayout.widget.ConstraintLayout>